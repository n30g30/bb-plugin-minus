+    await dom.flush();
+    assert.equal(fetchCount, 2);
+    assert.equal(metrics.textContent, '1 tool · 1.5s');
+    dom.dispose();assert.equal(unsubscribed, 1);
+    notify('thr_test', true);clock.advance(2000);
+    await dom.flush();assert.equal(fetchCount, 2);
